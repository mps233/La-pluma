{
  "name": "la-pluma-next-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-precache.ts",
    "lint": "eslint . --cache --max-warnings 12",
    "guardrails": "node scripts/check-guardrails.ts",
    "guardrails:size-baseline": "node scripts/check-guardrails.ts --update-size-baseline",
    "preview": "vite preview",
    "type-check": "tsc -b",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:integration": "node scripts/integration-docker.ts",
    "test:coverage": "vitest run --coverage",
    "stylelint": "stylelint \"src/**/*.css\"",
    "stylelint:ratchet": "node scripts/stylelint-ratchet.ts",
    "stylelint:baseline": "node scripts/stylelint-ratchet.ts --update-baseline",
    "verify": "pnpm run guardrails && pnpm run lint && pnpm run stylelint:ratchet && pnpm run build && pnpm run test",
    "verify:fast": "pnpm run guardrails && pnpm run lint && pnpm run type-check && pnpm run test:changed"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-query": "^5.104.5",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "framer-motion": "^12.29.2",
    "lucide-react": "^1.23.0",
    "pinyin-pro": "^3.29.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^25.2.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^28.0.0",
    "shadcn": "^4.23.0",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1",
    "zustand": "^5.0.11"
  }
}
